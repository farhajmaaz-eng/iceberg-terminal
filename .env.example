# ─────────────────────────────────────────────────────────────
# Iceberg Terminal — environment template
# ─────────────────────────────────────────────────────────────
# This file contains PLACEHOLDERS ONLY. Never commit a real .env file.
#
# IMPORTANT SECURITY NOTE:
#   Iceberg Terminal is a browser-only, BYOK application. Provider
#   credentials are entered in-app (Settings -> Providers) and stored
#   locally in your browser. Vite environment variables are inlined
#   into the JavaScript bundle at build time and are therefore PUBLIC.
#
#   Only place NON-SECRET defaults here (public endpoints, flags).
#   Anything prefixed with VITE_ ships to every visitor.
# ─────────────────────────────────────────────────────────────

# Optional: pre-select the Solana RPC flavour used for the "public" slot.
# One of: public | helius | alchemy | custom
VITE_DEFAULT_RPC_FLAVOUR=public

# Optional: default Solana JSON-RPC endpoint for the "public" slot.
# Leave blank to use https://api.mainnet-beta.solana.com
VITE_DEFAULT_RPC_URL=

# Optional: preferred market-data provider id.
# One of: dexscreener | geckoterminal | coingecko
VITE_DEFAULT_MARKET_PROVIDER=dexscreener

# Optional: force demo mode (deterministic sample data, clearly labelled).
# Useful for offline demos and screenshots. Never label demo data as live.
VITE_FORCE_DEMO_MODE=false

# Optional: analytics endpoint override. Left blank by default —
# Iceberg Terminal ships no telemetry and sends no keys anywhere.
VITE_TELEMETRY_ENDPOINT=